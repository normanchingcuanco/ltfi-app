{
  "expo": {
    "name": "LTFI",
    "slug": "ltfi",
    "version": "1.0.0",
    "scheme": "ltfi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "url": "https://u.expo.dev/330777bd-74a9-4489-aaf1-07cf5583d72b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#EDE8DF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ltfi.app",
      "infoPlist": {
        "NSHealthShareUsageDescription": "LTFI reads your health data including steps, heart rate, calories, and sleep to give you a complete picture of your health.",
        "NSHealthUpdateUsageDescription": "LTFI writes workout data to Apple Health."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE8DF"
      },
      "package": "com.ltfi.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "330777bd-74a9-4489-aaf1-07cf5583d72b"
      }
    },
    "owner": "norman.chingcuanco"
  }
}