{
  "expo": {
    "name": "LTFI",
    "slug": "ltfi",
    "version": "1.0.0",
    "scheme": "ltfi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#EDE8DF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ltfi.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDE8DF"
      },
      "package": "com.ltfi.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}